pipeline:
  name: __APPLICATION_TITLE__ Dev Delivery
  identifier: __HARNESS_PIPELINE_ID__
  projectIdentifier: __HARNESS_PROJECT_ID__
  orgIdentifier: __HARNESS_ORG_ID__
  description: Native Terraform plan/apply and Kubernetes rolling deployment for Dev.
  tags:
    managed-by: autonomous-factory
    target: dev
  variables:
    - name: commit_sha
      type: String
      required: true
      value: <+input>
  stages:
    - stage:
        name: Build and Publish
        identifier: build_and_publish
        type: Custom
        spec:
          execution:
            steps:
              - step:
                  name: Test and Publish Container
                  identifier: test_and_publish_container
                  type: ShellScript
                  timeout: 15m
                  spec:
                    shell: Bash
                    onDelegate: true
                    delegateSelectors: [__HARNESS_DELEGATE_SELECTOR__]
                    source:
                      type: Inline
                      spec:
                        script: |
                          set -euo pipefail
                          job=__APPLICATION_NAME__-build
                          kubectl -n __BUILD_NAMESPACE__ delete job "$job" --ignore-not-found --wait=true
                          kubectl -n __BUILD_NAMESPACE__ apply -f - <<'MANIFEST'
                          apiVersion: batch/v1
                          kind: Job
                          metadata:
                            name: __APPLICATION_NAME__-build
                          spec:
                            backoffLimit: 0
                            ttlSecondsAfterFinished: 900
                            template:
                              spec:
                                serviceAccountName: __BUILD_SERVICE_ACCOUNT__
                                restartPolicy: Never
                                volumes:
                                  - name: workspace
                                    emptyDir: {}
                                initContainers:
                                  - name: checkout
                                    image: alpine/git:v2.45.2
                                    env:
                                      - name: GITHUB_TOKEN
                                        valueFrom:
                                          secretKeyRef:
                                            name: __GITHUB_TOKEN_SECRET__
                                            key: token
                                      - name: COMMIT_SHA
                                        value: "<+pipeline.variables.commit_sha>"
                                    command: ["/bin/sh", "-ec"]
                                    args:
                                      - |
                                        git clone --depth 1 https://x-access-token:${GITHUB_TOKEN}@github.com/__GITHUB_REPOSITORY__.git /workspace
                                        cd /workspace
                                        git fetch --depth 1 origin "${COMMIT_SHA}"
                                        git checkout --detach FETCH_HEAD
                                    volumeMounts:
                                      - name: workspace
                                        mountPath: /workspace
                                  - name: test
                                    image: __TEST_IMAGE__
                                    command: ["/bin/sh", "-ec"]
                                    args: ["cd /workspace/__BUILD_CONTEXT__ && __TEST_COMMAND__"]
                                    volumeMounts:
                                      - name: workspace
                                        mountPath: /workspace
                                containers:
                                  - name: publish
                                    image: gcr.io/kaniko-project/executor:v1.23.2-debug
                                    args:
                                      - --context=dir:///workspace/__BUILD_CONTEXT__
                                      - --dockerfile=/workspace/__DOCKERFILE__
                                      - --destination=__AWS_ACCOUNT_ID__.dkr.ecr.__AWS_REGION__.amazonaws.com/__ECR_REPOSITORY__:<+pipeline.variables.commit_sha>
                                    volumeMounts:
                                      - name: workspace
                                        mountPath: /workspace
                          MANIFEST
                          kubectl -n __BUILD_NAMESPACE__ wait --for=condition=complete "job/$job" --timeout=12m || {
                            kubectl -n __BUILD_NAMESPACE__ logs "job/$job" --all-containers=true --tail=200
                            exit 1
                          }
                          kubectl -n __BUILD_NAMESPACE__ logs "job/$job" --all-containers=true --tail=200
    - stage:
        name: Terraform Provisioning
        identifier: terraform_provisioning
        type: Custom
        spec:
          execution:
            steps:
              - step:
                  name: Terraform Plan
                  identifier: terraform_plan
                  type: TerraformPlan
                  timeout: 15m
                  spec:
                    provisionerIdentifier: __TERRAFORM_PROVISIONER_ID__
                    delegateSelectors: [__HARNESS_DELEGATE_SELECTOR__]
                    configuration:
                      command: Apply
                      configFiles:
                        store:
                          type: Github
                          spec:
                            connectorRef: __HARNESS_GITHUB_CONNECTOR_REF__
                            repoName: __GITHUB_REPOSITORY_NAME__
                            gitFetchType: Commit
                            commitSha: <+pipeline.variables.commit_sha>
                            folderPath: __TERRAFORM_ROOT__
                        moduleSource:
                          useConnectorCredentials: true
                      secretManagerRef: harnessSecretManager
                      skipStateStorage: false
              - step:
                  name: Terraform Apply
                  identifier: terraform_apply
                  type: TerraformApply
                  timeout: 20m
                  spec:
                    provisionerIdentifier: __TERRAFORM_PROVISIONER_ID__
                    delegateSelectors: [__HARNESS_DELEGATE_SELECTOR__]
                    configuration:
                      type: InheritFromPlan
    - stage:
        name: Deploy to Dev
        identifier: deploy_to_dev
        type: Deployment
        spec:
          deploymentType: Kubernetes
          service:
            serviceRef: __HARNESS_SERVICE_REF__
            serviceInputs:
              serviceDefinition:
                type: Kubernetes
                spec:
                  artifacts:
                    primary:
                      primaryArtifactRef: __HARNESS_PRIMARY_ARTIFACT_REF__
                      sources:
                        - identifier: __HARNESS_PRIMARY_ARTIFACT_REF__
                          type: Ecr
                          spec:
                            tag: <+pipeline.variables.commit_sha>
          environment:
            environmentRef: __HARNESS_ENVIRONMENT_REF__
            deployToAll: false
            infrastructureDefinitions:
              - identifier: __HARNESS_INFRASTRUCTURE_REF__
          execution:
            steps:
              - step:
                  name: Native Kubernetes Rolling Deploy
                  identifier: native_kubernetes_rolling_deploy
                  type: K8sRollingDeploy
                  timeout: 15m
                  spec:
                    skipDryRun: false
                    pruningEnabled: false
