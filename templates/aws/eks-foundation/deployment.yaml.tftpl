# Reference only. Infer the application port and runtime settings from source.
# Do not invent an external resource dependency for a foundation-only service.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: __APPLICATION_NAME__
  namespace: __NAMESPACE__
spec:
  replicas: 1
  selector:
    matchLabels:
      app: __APPLICATION_NAME__
  template:
    metadata:
      labels:
        app: __APPLICATION_NAME__
    spec:
      serviceAccountName: __SERVICE_ACCOUNT__
      containers:
        - name: application
          image: <+artifact.image>
          ports:
            - containerPort: __APPLICATION_PORT__
