variable "application_name" {
  type    = string
  default = "__APPLICATION_NAME__"
}

variable "aws_region" {
  type    = string
  default = "__AWS_REGION__"
}

variable "cluster_name" {
  type    = string
  default = "__EKS_CLUSTER_NAME__"
}

variable "namespace" {
  type    = string
  default = "__KUBERNETES_NAMESPACE__"
}

variable "service_account_name" {
  type    = string
  default = "__SERVICE_ACCOUNT_NAME__"
}

# When the application contract specifies a boundary, the agent must persist
# its approved ARN as this default in the generated root (not only TF_VAR_*).
variable "permissions_boundary_arn" {
  description = "Pre-existing, operator-approved application role permissions boundary."
  type        = string
  default     = null
  validation {
    condition     = var.permissions_boundary_arn == null || can(regex("^arn:(aws|aws-us-gov|aws-cn):iam::[0-9]{12}:policy/[A-Za-z0-9+=,.@_-]+(/[A-Za-z0-9+=,.@_-]+)*$", var.permissions_boundary_arn))
    error_message = "Use null or a customer-managed IAM policy ARN; do not create or modify the boundary policy."
  }
}
